# ==============================================================================
# Cerevyn Azure Support Ticket Automation (PS04) - Environment Variables
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Provider Configuration (OpenAI-Compatible)
# ------------------------------------------------------------------------------
# The application connects to any OpenAI-compatible completions endpoint.
# If GROQ_API_KEY is left empty or unset, the system gracefully falls back
# to the deterministic TemplateClient.

# --- PRESET 1: Groq Direct (Free Tier / High Speed) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# (Note: Verify the latest active model in the Groq Cloud Console, e.g., llama-3.3-70b-versatile)

# --- PRESET 2: Local OmniRoute / LiteLLM / LocalAI Gateway ---
# LLM_BASE_URL=http://localhost:8080/v1
# GROQ_API_KEY=local-gateway-key
# LLM_MODEL=local-model-name

# --- PRESET 3: Azure OpenAI Service (Production Recommendation) ---
# LLM_BASE_URL=https://your-resource-name.openai.azure.com/openai/deployments/your-deployment-name
# GROQ_API_KEY=your_azure_openai_key_from_keyvault
# LLM_MODEL=gpt-4o-mini

# Active configuration fields (Set these according to your selected provider):
GROQ_API_KEY=
LLM_BASE_URL=
LLM_MODEL=llama-3.3-70b-versatile

# Runtime request timeout in seconds (default: 10.0)
LLM_TIMEOUT_SECONDS=10.0

# Sampling temperature (default: 0.2 for deterministic, factual outputs)
LLM_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# 2. ML Classifier & Routing Settings
# ------------------------------------------------------------------------------
# Leave CONFIDENCE_THRESHOLD empty to use the cross-validation tuned threshold (0.35)
# determined strictly on the training set (StratifiedKFold, N=20).
# Set a custom float (e.g. 0.40) to override.
CONFIDENCE_THRESHOLD=

# Sentence Transformers embedding model name
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 3. Persistence & Database
# ------------------------------------------------------------------------------
# SQLite database URL (local development). For production, use PostgreSQL Flexible Server.
DATABASE_URL=sqlite:///./tickets.db

# ------------------------------------------------------------------------------
# 4. Logging & Diagnostics
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
